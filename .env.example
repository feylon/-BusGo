# ---------- Shared ----------
NODE_ENV=production
INTERNAL_TOKEN=change-me-internal-token
FRONTEND_URL=http://localhost:8080

# ---------- Infrastructure ----------
POSTGRES_USER=bus
POSTGRES_PASSWORD=bus_secret
POSTGRES_DB=bus_core
REDIS_URL=redis://redis:6379
RABBITMQ_USER=bus
RABBITMQ_PASSWORD=bus_secret
RABBITMQ_URL=amqp://bus:bus_secret@rabbitmq:5672

# ---------- Main API ----------
PORT=3000
DATABASE_URL=postgres://bus:bus_secret@postgres:5432/bus_core
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=30
QR_SECRET=change-me-qr-signing-secret
RATE_LIMIT_PER_MIN=300
SEED_ON_START=true
SEED_DAYS=7

# ---------- Microservice databases ----------
NOTIFICATION_DATABASE_URL=postgres://bus:bus_secret@postgres:5432/bus_notification
AUDIT_DATABASE_URL=postgres://bus:bus_secret@postgres:5432/bus_audit
TRACKING_DATABASE_URL=postgres://bus:bus_secret@postgres:5432/bus_tracking
PAYMENT_DATABASE_URL=postgres://bus:bus_secret@postgres:5432/bus_payment
REPORTING_DATABASE_URL=postgres://bus:bus_secret@postgres:5432/bus_reporting

# ---------- Providers (mock only for now) ----------
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ---------- OTP ----------
OTP_SECRET=change-me-otp-secret
OTP_TTL_SEC=120
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5
OTP_HOURLY_LIMIT=5
# Shows the code in API responses (demo only). Keep false in real production.
OTP_EXPOSE_CODE=true

# ---------- Retention ----------
NOTIFICATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
TRACKING_RETENTION_DAYS=30

# ---------- Host ports ----------
WEB_PORT=8080
API_PORT=3000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
RABBITMQ_UI_PORT=15672
